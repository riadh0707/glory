{
  "name": "glory-fcc-client",
  "productName": "Glory FCC Client",
  "version": "1.0.0",
  "private": true,
  "description": "Client Electron pilotant un FCC Glory (ISP-K05B) via BrueBoxService (SOAP). Voir docs/ à la racine du SDK pour la documentation de référence.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/ui',{recursive:true});fs.copyFileSync('src/ui/index.html','dist/ui/index.html');fs.copyFileSync('src/ui/styles.css','dist/ui/styles.css')\"",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "axios": "^1.18.1",
    "soap": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "typescript": "^7.0.2"
  }
}

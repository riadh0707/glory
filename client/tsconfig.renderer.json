{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist/ui",
    "rootDir": "src/ui",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/ui/global.d.ts", "src/ui/i18n.ts", "src/ui/lib.ts", "src/ui/scanner.ts", "src/ui/screens.ts", "src/ui/catalog.ts", "src/ui/app.ts"]
}
